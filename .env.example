# Keep these values secret; configure them in Render Environment, not frontend code.
GEMINI_API_KEY=YOUR_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
ADMIN_PASSWORD=CHANGE_TO_A_LONG_RANDOM_PASSWORD
SESSION_SECRET=CHANGE_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
# Optional local data path; Render free filesystem is ephemeral.
DATA_DIR=./data
PORT=3000
